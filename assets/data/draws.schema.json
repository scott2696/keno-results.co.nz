{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Keno NZ draw feed",
  "type": "object",
  "required": ["game", "numberRange", "drawSize", "draws"],
  "properties": {
    "game":        { "const": "Keno NZ" },
    "numberRange": { "const": [1, 80] },
    "drawSize":    { "const": 20 },
    "source":      { "type": ["string", "null"], "description": "Named upstream provider. Shown in the provenance strip." },
    "retrievedAt": { "type": ["string", "null"], "format": "date-time" },
    "draws": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "drawnAt", "numbers"],
        "properties": {
          "id":      { "type": "string", "description": "Official draw number." },
          "drawnAt": { "type": "string", "format": "date-time", "description": "ISO 8601 with NZ offset." },
          "numbers": {
            "type": "array",
            "minItems": 20,
            "maxItems": 20,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 1, "maximum": 80 }
          }
        }
      }
    }
  }
}
